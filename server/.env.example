# Copy this file to server/.env and fill in your own values.

# Database. Leave both blank for local dev — it writes to server/data/exploration.db, a plain
# file, no account needed. On Vercel (or any host with a read-only/ephemeral filesystem) these
# are required instead: create a free database at turso.tech, then `turso db show <name> --url`
# and `turso db tokens create <name>` for the two values below. Set them in Vercel's project
# settings, not in this file — server/.env is never deployed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Free Spotify developer credentials: https://developer.spotify.com/dashboard
# Create an app there, then copy its Client ID and Client Secret below.
# Used only for the free Client Credentials search flow (no user login, no cost).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — TMDB movie search for Movie Nights (free at themoviedb.org/settings/api).
# App-level API key like Spotify Client Credentials — no personal account linking needed.
TMDB_API_KEY=

# Optional — conversation sparks after Deep Dive reveals
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Admin panel HTTP Basic Auth (required to access /admin and admin-only APIs).
# If either is missing, admin routes refuse requests (fail closed — not open).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-secret

# CORS: origin allowed to call this API (browser requests).
# In production, set this to the real deployed frontend URL (e.g. https://yourdomain.com).
# Defaults to http://localhost:5173 (Vite dev) when unset.
ALLOWED_ORIGIN=http://localhost:5173

# Rate limits (requests per IP per 15-minute window).
# AI calls OpenRouter — keep this stricter. Music hits Spotify search — moderate.
AI_RATE_LIMIT_MAX=20
MUSIC_RATE_LIMIT_MAX=60

# Set to 1 (or a hop count) when running behind a proxy/tunnel (Railway, Fly, cloudflared)
# so rate limits use the real client IP. Not needed on Vercel — it is detected automatically.
# TRUST_PROXY=1

# Optional overrides for the per-IP, per-15-minute write limits.
# API_RATE_LIMIT_MAX=600
# SESSIONS_RATE_LIMIT_MAX=60
# EVENTS_RATE_LIMIT_MAX=300
# DIARY_RATE_LIMIT_MAX=60
